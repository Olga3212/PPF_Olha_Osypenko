---
import { ui, type Lang } from "../i18n/ui";

interface Props {
  lang: Lang;
}

const { lang } = Astro.props as Props;
const s = ui[lang].sections.docs;
const base = `/${lang}`;

// Formas CSS sencillas para los iconos, una por tarjeta.
// Círculo, cuadrado redondeado y rombo (cuadrado rotado).
const shapes = [
  "rounded-full",
  "rounded-xl",
  "rotate-45 rounded-[10px]",
] as const;
---

<section id="docs" aria-labelledby="docs-title" class="scroll-mt-20 bg-surface">
  <div class="mx-auto max-w-5xl px-4 py-16 sm:px-6 sm:py-20 lg:py-24">
    <div class="mx-auto max-w-2xl text-center">
      <p
        class="text-xs font-bold tracking-[0.2em] text-teal-800 uppercase sm:text-sm"
      >
        {s.eyebrow}
      </p>
      <h2
        id="docs-title"
        class="mt-3 text-3xl font-black tracking-tight text-balance text-neutral-950 sm:text-4xl lg:text-[2.75rem] lg:leading-[1.1]"
      >
        {s.title}
      </h2>
      <p
        class="mt-4 text-base leading-relaxed text-pretty text-neutral-700 sm:text-lg"
      >
        {s.intro}
      </p>
    </div>

    <ul
      class="mt-10 grid grid-cols-1 gap-6 sm:grid-cols-2 lg:grid-cols-3"
    >
      {
        s.cards.map((card, i) => (
          <li class="h-full">
            <article class="flex h-full flex-col rounded-2xl border border-neutral-200 bg-white p-6 shadow-sm transition-all duration-200 hover:-translate-y-1 hover:border-teal-900/20 hover:shadow-md focus-within:-translate-y-1 focus-within:border-teal-900/20 focus-within:shadow-md sm:p-7">
              <span
                aria-hidden="true"
                class="flex h-11 w-11 items-center justify-center bg-teal-800/10"
              >
                <span
                  class:list={[
                    "block h-5 w-5 bg-teal-800",
                    shapes[i % shapes.length],
                  ]}
                />
              </span>
              <h3 class="mt-5 text-lg font-bold tracking-tight text-neutral-950">
                {card.title}
              </h3>
              <p class="mt-2 flex-1 text-base leading-relaxed text-neutral-700">
                {card.desc}
              </p>
              <a
                href={`${base}/#docs`}
                class="mt-5 inline-flex items-center gap-1.5 rounded-sm py-1 text-sm font-semibold text-teal-800 underline-offset-4 hover:underline focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-teal-800"
              >
                {card.link}
                <span aria-hidden="true">→</span>
              </a>
            </article>
          </li>
        ))
      }
    </ul>
  </div>
</section>
