---
import Placeholder from "./Placeholder.astro";
import { useTranslations, type Lang } from "../i18n/utils";

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
const base = `/${lang}`;
---
<section aria-labelledby="hero-title" class="bg-surface">
  <div class="mx-auto max-w-5xl px-4 pt-16 pb-16 sm:px-6 sm:pt-24 sm:pb-20 lg:pt-28 lg:pb-24">
    <div class="mx-auto max-w-3xl text-center">
      <p class="text-xs font-bold tracking-[0.2em] text-teal-800 uppercase sm:text-sm">
        {t("hero.eyebrow")}
      </p>
      <h1
        id="hero-title"
        class="mt-4 text-4xl leading-[1.05] font-black tracking-tight text-balance text-neutral-950 sm:text-5xl lg:text-6xl"
      >
        {t("hero.title")}
      </h1>
      <p class="mx-auto mt-6 max-w-2xl text-base leading-relaxed text-pretty text-neutral-700 sm:text-lg">
        {t("hero.description")}
      </p>
      <div class="mt-8 flex flex-col items-stretch justify-center gap-3 sm:flex-row sm:items-center">
        <a
          href={base + "/#nosotros"}
          class="rounded-full bg-teal-700 px-7 py-3 text-sm font-semibold text-white transition-colors hover:bg-teal-800 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-teal-700"
        >
          {t("buttons.about")}
        </a>
        <a
          href={base + "/#menu"}
          class="rounded-full border border-teal-900/20 bg-white/60 px-7 py-3 text-sm font-semibold text-neutral-900 transition-colors hover:border-teal-800 hover:bg-white focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-teal-800"
        >
          {t("buttons.menu")}
        </a>
      </div>
    </div>

    <figure class="mt-12 sm:mt-14">
      <Placeholder label={t("hero.caption")} aspect="aspect-video" rounded={true} />
      <figcaption class="mt-3 text-center text-sm text-neutral-500">
        {t("hero.caption")}
      </figcaption>
    </figure>
  </div>
</section>
