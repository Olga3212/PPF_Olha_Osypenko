---
import FeatureSection from "./FeatureSection.astro";
import { ui, type Lang } from "../i18n/ui";

interface Props {
  lang: Lang;
}

const { lang } = Astro.props as Props;
const s = ui[lang].sections.flexibleMenu;
const base = `/${lang}`;
---

<FeatureSection
  id="menu"
  titleId="menu-title"
  eyebrow={s.eyebrow}
  title={s.title}
  description={s.intro}
  features={s.items}
  buttonText={s.link}
  href={`${base}/#menu`}
  imagePosition="right"
  tone="white"
  imageLabel={s.imageLabel}
  imageCaption={s.imageCaption}
/>
