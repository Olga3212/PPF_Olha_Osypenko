---
// Este archivo genera `/` y, con `redirectToDefaultLocale: true`,
// Astro redirige automáticamente a `/es/`.
---
<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta http-equiv="refresh" content="0; url=/es/" />
    <link rel="canonical" href="/es/" />
    <title>Redirigiendo…</title>
  </head>
  <body>
    <p>Redirigiendo a <a href="/es/">/es/</a>…</p>
  </body>
</html>
