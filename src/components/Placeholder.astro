---
interface Props {
  label: string;
  sub?: string;
  aspect?: string;
  rounded?: boolean;
}

const {
  label,
  sub = "IMAGE PLACEHOLDER",
  aspect = "aspect-video",
  rounded = true,
} = Astro.props;
---
<div
  role="img"
  aria-label={label}
  class:list={[
    "flex flex-col items-center justify-center gap-1 border-2 border-dashed border-teal-900/25 bg-white px-6 py-8 text-center text-neutral-500",
    aspect,
    rounded && "rounded-lg",
  ]}
>
  <span class="text-xs font-bold tracking-widest uppercase sm:text-sm">{sub}</span>
  <span class="max-w-full text-base font-semibold break-words sm:text-lg">{label}</span>
</div>
