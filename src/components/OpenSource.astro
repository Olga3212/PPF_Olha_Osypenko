---
import Placeholder from "./Placeholder.astro";
import CheckIcon from "./CheckIcon.astro";
import { ui, type Lang } from "../i18n/ui";

interface Props {
  lang: Lang;
}

const { lang } = Astro.props as Props;
const s = ui[lang].sections.openSource;
const ctaLabel = ui[lang].buttons.book;
const base = `/${lang}`;
---

<section
  id="reservar"
  aria-labelledby="opensource-title"
  class="scroll-mt-20 bg-white"
>
  <div class="mx-auto max-w-5xl px-4 py-16 sm:px-6 sm:py-20 lg:py-24">
    <div
      class="grid overflow-hidden rounded-3xl bg-neutral-950 shadow-xl md:grid-cols-2"
    >
      <figure class="p-6 sm:p-8 md:p-10">
        <Placeholder
          label={s.imageLabel}
          aspect="aspect-[4/3]"
          rounded={true}
        />
        <figcaption class="mt-3 text-center text-sm text-neutral-400 md:text-left">
          {s.imageCaption}
        </figcaption>
      </figure>

      <article
        class="flex flex-col justify-center p-6 pt-2 sm:p-8 sm:pt-2 md:p-10 lg:p-14"
      >
        <p
          class="text-xs font-bold tracking-[0.2em] text-teal-200 uppercase sm:text-sm"
        >
          {s.eyebrow}
        </p>
        <h2
          id="opensource-title"
          class="mt-3 text-3xl font-black tracking-tight text-balance text-white sm:text-4xl lg:text-[2.75rem] lg:leading-[1.1]"
        >
          {s.title}
        </h2>
        <p
          class="mt-4 text-base leading-relaxed text-pretty text-neutral-300 sm:text-lg"
        >
          {s.intro}
        </p>

        <ul class="mt-6 space-y-3">
          {
            s.items.map((item) => (
              <li class="flex items-start gap-3 text-base text-neutral-200">
                <CheckIcon class="text-teal-200" haloOpacity="0.15" />
                <span>{item}</span>
              </li>
            ))
          }
        </ul>

        <div class="mt-8">
          <a
            href={`${base}/#reservar`}
            class="inline-block rounded-full bg-white px-7 py-3 text-sm font-semibold text-neutral-950 transition-colors hover:bg-teal-50 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-white"
          >
            {ctaLabel}
          </a>
        </div>
      </article>
    </div>
  </div>
</section>
