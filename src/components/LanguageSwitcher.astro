---
import { getRelativeLocaleUrl } from "astro:i18n";
import type { Lang } from "../i18n/utils";

interface Props {
  lang: Lang;
  variant?: "desktop" | "mobile";
}

const { lang, variant = "desktop" } = Astro.props;

const esUrl = getRelativeLocaleUrl("es");
const enUrl = getRelativeLocaleUrl("en");
---
<div>
  <ul
    class:list={[
      "flex items-center gap-1 text-sm",
      variant === "mobile" && "justify-center border-t border-neutral-100 pt-2",
    ]}
  >
    <li>
      <a
        href={esUrl}
        hreflang="es"
        rel="alternate"
        aria-current={lang === "es" ? "page" : undefined}
        class:list={[
          "rounded px-1.5 py-1 transition-colors focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-neutral-900",
          lang === "es"
            ? "font-bold text-neutral-950 underline underline-offset-4"
            : "text-neutral-500 hover:bg-neutral-100 hover:text-neutral-900",
        ]}
      >
        ES
      </a>
    </li>
    <li aria-hidden="true" class="text-neutral-300">|</li>
    <li>
      <a
        href={enUrl}
        hreflang="en"
        rel="alternate"
        aria-current={lang === "en" ? "page" : undefined}
        class:list={[
          "rounded px-1.5 py-1 transition-colors focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-neutral-900",
          lang === "en"
            ? "font-bold text-neutral-950 underline underline-offset-4"
            : "text-neutral-500 hover:bg-neutral-100 hover:text-neutral-900",
        ]}
      >
        EN
      </a>
    </li>
  </ul>
</div>
