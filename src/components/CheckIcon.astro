---
// Icono de verificación usado en las listas de ventajas.
// Extraído para no duplicar el SVG (FeatureSection, OpenSource).
// El HTML generado es idéntico al que había en cada componente.

interface Props {
  class?: string;
  haloOpacity?: string;
}

const { class: className = "", haloOpacity = "0.12" } = Astro.props;
---

<svg
  aria-hidden="true"
  viewBox="0 0 20 20"
  fill="none"
  class:list={["mt-1 h-5 w-5 shrink-0", className]}
>
  <circle cx="10" cy="10" r="9" fill="currentColor" opacity={haloOpacity} />
  <path
    d="m6.5 10.2 2.4 2.4 4.6-5"
    stroke="currentColor"
    stroke-width="1.8"
    stroke-linecap="round"
    stroke-linejoin="round"
  />
</svg>
