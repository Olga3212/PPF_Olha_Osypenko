---
import Placeholder from "./Placeholder.astro";
---
<section id="ofertas" aria-labelledby="deals-title">
  <h2 id="deals-title">Tasty deals</h2>
  <p>You can show your happy hour deals here</p>
  <ul>
    <li>
      <article>
        <Placeholder label="Tapas Dish" aspect="aspect-[4/5]" />
        <h3>Tapas For Two</h3>
        <p>25% of tapas for two, every Sunday</p>
        <p><data value="750">$750</data></p>
      </article>
    </li>
    <li>
      <article>
        <Placeholder label="Mojito Drink" aspect="aspect-[4/5]" />
        <h3>Mojito Monday</h3>
        <p>Every Monday from 5am to 7am</p>
        <p><data value="400">$400</data></p>
      </article>
    </li>
    <li>
      <article>
        <Placeholder label="Margarita Drink" aspect="aspect-[4/5]" />
        <h3>Margarita Thursday</h3>
        <p>Every Thursday from 5am to 7am</p>
        <p><data value="350">$350</data></p>
      </article>
    </li>
  </ul>
</section>
