---
import FeatureSection from "./FeatureSection.astro";
import { ui, type Lang } from "../i18n/ui";

interface Props {
  lang: Lang;
}

const { lang } = Astro.props as Props;
const s = ui[lang].sections.lightning;
---

<FeatureSection
  id="servicio"
  titleId="fast-title"
  eyebrow={s.eyebrow}
  title={s.title}
  description={s.intro}
  features={s.items}
  imagePosition="right"
  tone="white"
  imageLabel={s.imageLabel}
  imageCaption={s.imageCaption}
/>
