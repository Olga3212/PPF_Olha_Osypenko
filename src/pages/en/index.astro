---
import Layout from "../../layouts/Layout.astro";
import Header from "../../components/Header.astro";
import Hero from "../../components/Hero.astro";
import FlexibleMenu from "../../components/FlexibleMenu.astro";
import VisualEditing from "../../components/VisualEditing.astro";
import LightningFast from "../../components/LightningFast.astro";
import DocsFeatures from "../../components/DocsFeatures.astro";
import OpenSource from "../../components/OpenSource.astro";
import TastyDeals from "../../components/TastyDeals.astro";
import Footer from "../../components/Footer.astro";
---

<Layout
  lang="en"
  title="Astrorante — Restaurant (educational exercise)"
  description="Restaurant landing page in English built with Astro and Tailwind CSS 4. Structural replica for educational purposes."
>
  <Header lang="en" />
  <main id="contenido" tabindex="-1" class="focus:outline-none">
    <Hero lang="en" />
    <FlexibleMenu lang="en" />
    <VisualEditing lang="en" />
    <LightningFast lang="en" />
    <DocsFeatures lang="en" />
    <OpenSource lang="en" />
    <TastyDeals lang="en" />
  </main>
  <Footer lang="en" />
</Layout>
