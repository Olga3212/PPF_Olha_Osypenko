---
import { ui, type Lang } from "../i18n/ui";

interface Props {
  lang: Lang;
}

const { lang } = Astro.props as Props;
const deals = ui[lang].deals;

// Array de ofertas con la forma pedida: title / description / price.
// Los textos viven en `src/i18n/ui.ts` (sin hardcodear) y aquí se
// normalizan a esa forma antes de recorrerlos con `map()`.
const offers = deals.items.map((item) => ({
  title: item.name,
  description: item.desc,
  price: item.price,
}));
---

<section id="ofertas" aria-labelledby="deals-title" class="scroll-mt-20 bg-surface">
  <div class="mx-auto max-w-5xl px-4 py-16 sm:px-6 sm:py-20 lg:py-24">
    <div class="mx-auto max-w-2xl text-center">
      <h2
        id="deals-title"
        class="text-3xl font-black tracking-tight text-balance text-neutral-950 sm:text-4xl lg:text-[2.75rem] lg:leading-[1.1]"
      >
        {deals.title}
      </h2>
      <p
        class="mt-4 text-base leading-relaxed text-pretty text-neutral-700 sm:text-lg"
      >
        {deals.subtitle}
      </p>
    </div>

    <ul class="mt-10 grid grid-cols-1 gap-6 md:grid-cols-3">
      {
        offers.map((offer) => (
          <li class="h-full">
            <article class="flex h-full flex-col rounded-2xl border border-neutral-200 bg-white p-6 shadow-sm transition-all duration-200 hover:-translate-y-1 hover:border-teal-900/20 hover:shadow-md sm:p-7">
              <h3 class="text-lg font-bold tracking-tight text-neutral-950">
                {offer.title}
              </h3>
              <p class="mt-2 flex-1 text-base leading-relaxed text-neutral-700">
                {offer.description}
              </p>
              <p class="mt-5">
                <data
                  value={offer.price}
                  class="inline-block rounded-full bg-teal-800/10 px-5 py-2 text-2xl font-black tracking-tight text-teal-900"
                >
                  {offer.price}
                </data>
              </p>
            </article>
          </li>
        ))
      }
    </ul>
  </div>
</section>
