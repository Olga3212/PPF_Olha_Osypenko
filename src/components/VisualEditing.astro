---
import FeatureSection from "./FeatureSection.astro";
import { ui, type Lang } from "../i18n/ui";

interface Props {
  lang: Lang;
}

const { lang } = Astro.props as Props;
const s = ui[lang].sections.visualEditing;
const base = `/${lang}`;
---

<FeatureSection
  id="nosotros"
  titleId="editing-title"
  eyebrow={s.eyebrow}
  title={s.title}
  description={s.text}
  buttonText={s.link}
  href={`${base}/#nosotros`}
  imagePosition="left"
  tone="cream"
  imageLabel={s.imageLabel}
  imageCaption={s.imageCaption}
/>
